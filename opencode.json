{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.3-flash",
  "small_model": "openrouter/google/gemma-4-31b-it:free",
  "instructions": [
    ".opencode/style.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 12000,
    "reserved": 10000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "limit": {
            "context": 180000,
            "output": 16384
          },
          "options": {
            "provider": {
              "order": [
                "relace",
                "deepinfra",
                "gmicloud",
                "makora",
                "fireworks",
                "parasail",
                "morph",
                "z-ai",
                "novita"
              ],
              "allow_fallbacks": true,
              "data_collection": "allow"
            }
          }
        },
        "google/gemma-4-31b-it:free": {
          "options": {
            "models": [
              "poolside/laguna-s-2.1:free",
              "poolside/laguna-xs-2.1:free",
              "meta-llama/llama-3.1-8b-instruct:free"
            ],
            "provider": {
              "allow_fallbacks": true,
              "data_collection": "allow"
            }
          }
        }
      }
    }
  }
}