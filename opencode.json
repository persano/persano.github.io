{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.3-flash",
  "small_model": "openrouter/google/gemma-4-31b-it:free",
  "instructions": [
    "Execute commands and file edits silently without conversational preamble.",
    "Do not explain what you plan to do before a tool call—run the tool immediately.",
    "Respond in terse technical fragments. Omit conversational filler, polite intros, and self-evident summaries.",
    "Only provide detailed textual explanations when explicitly prompted by the user."
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": 10000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "limit": {
            "context": 75000,
            "output": 8192
          },
          "options": {
            "provider": {
              "sort": {
                "by": "latency",
                "partition": null
              },
              "order": [
                "relace",
                "deepinfra",
                "gmicloud",
                "makora",
                "fireworks",
                "parasail",
                "morph",
                "z-ai",
                "novita"
              ],
              "allow_fallbacks": true,
              "data_collection": "allow"
            }
          }
        },
        "google/gemma-4-31b-it:free": {
          "options": {
            "models": [
              "google/gemma-4-31b-it:free",
              "poolside/laguna-s-2.1:free",
              "poolside/laguna-xs-2.1:free",
              "meta-llama/llama-3.1-8b-instruct:free"
            ],
            "provider": {
              "allow_fallbacks": true,
              "data_collection": "allow"
            }
          }
        }
      }
    }
  }
}